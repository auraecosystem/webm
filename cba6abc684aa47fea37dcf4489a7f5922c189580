      "writtenOn": "2026-02-13T19:24:40Z",
      "side": 1,
      "message": "Please conform that `pbi-\u003edecrypt_cb()` writes `n` bytes into `clear_buffer`.\n\nThis will allow subsequent code to read three bytes from `clear` whether `clear` points to `data` or `clear_buffer`.",
      "revId": "cba6abc684aa47fea37dcf4489a7f5922c189580",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
